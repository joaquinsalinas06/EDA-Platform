---
import { knowledgeMap } from '../lib/knowledge-map';

// La navegación sale entera del knowledge map: no hay rutas escritas a mano.
const current = Astro.url.pathname;

// La semana que contiene el tema activo se abre siempre, sin importar lo que
// diga localStorage — no tiene sentido navegar a un tema y que su propia
// semana aparezca colapsada.
const activeWeek = knowledgeMap.weeks.find((week) =>
  week.topics.some((id) => current === `/structures/${id}` || current.startsWith(`/structures/${id}/`)),
)?.id;
---

<nav class="min-w-0 lg:sticky lg:top-20 lg:h-fit" aria-label="Mapa del curso">
  <span hidden data-active-week={activeWeek} />
  <div class="stagger">
    {
      knowledgeMap.weeks.map((week) => (
        <details class="group mb-7 [&_summary::-webkit-details-marker]:hidden" data-week={week.id} open>
          <summary class="mb-2 flex cursor-pointer list-none items-center gap-1.5 no-underline hover:text-[var(--accent)]">
            <svg
              viewBox="0 0 10 10"
              class="h-2.5 w-2.5 shrink-0 fill-[var(--faint)] transition-transform duration-200 group-open:rotate-90"
              aria-hidden="true"
            >
              <path d="M2 1 L8 5 L2 9 Z" />
            </svg>
            <span class="tag">{week.id}</span>
          </summary>

          <ul class="space-y-px pl-4">
            {week.topics.map((id) => {
              const t = knowledgeMap.topics[id];
              const href = `/structures/${id}`;
              const active = current === href || current.startsWith(`${href}/`);
              const ready = t?.status === 'generated';
              return (
                <li>
                  {ready ? (
                    <a
                      href={href}
                      class:list={[
                        'relative block rounded-r py-1.5 pl-3.5 pr-2 text-[0.8125rem] leading-snug no-underline transition-all',
                        active
                          ? 'bg-[var(--accent-wash)] font-medium text-[var(--accent)]'
                          : 'text-[var(--muted)] hover:bg-[var(--fill)] hover:text-[var(--ink)]',
                      ]}
                    >
                      <span
                        class:list={[
                          'absolute inset-y-0 left-0 w-[2px] rounded transition-all duration-300',
                          active ? 'bg-[var(--accent)]' : 'bg-[var(--rule)]',
                        ]}
                      />
                      {t?.title ?? id}
                    </a>
                  ) : (
                    <span class="relative block py-1.5 pl-3.5 pr-2 text-[0.8125rem] leading-snug text-[var(--faint)]">
                      <span class="absolute inset-y-0 left-0 w-[2px] rounded bg-[var(--rule)]" />
                      {t?.title ?? id}
                      <span class="tag ml-1.5">pendiente</span>
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      ))
    }
  </div>
</nav>

<script>
  // Recuerda qué semanas dejó abiertas o cerradas cada quien, por semana.
  // La semana activa ya llegó abierta desde el server (arriba); acá sólo se
  // restaura el estado de las demás y se persiste lo que el usuario cambie.
  const KEY = (id: string) => `nav:week:${id}`;

  const activeWeek = document.querySelector<HTMLElement>('[data-active-week]')?.dataset.activeWeek;

  for (const el of document.querySelectorAll<HTMLDetailsElement>('details[data-week]')) {
    const id = el.dataset.week!;
    if (id === activeWeek) continue; // la semana activa manda: siempre abierta

    try {
      const saved = localStorage.getItem(KEY(id));
      if (saved !== null) el.open = saved === '1';
    } catch {
      // localStorage puede fallar (ventana privada, cuota); se queda abierta
      // (el estado por defecto del servidor).
    }
  }

  for (const el of document.querySelectorAll<HTMLDetailsElement>('details[data-week]')) {
    el.addEventListener('toggle', () => {
      try {
        localStorage.setItem(KEY(el.dataset.week!), el.open ? '1' : '0');
      } catch {
        // per-viewer, no crítico si no persiste
      }
    });
  }
</script>
