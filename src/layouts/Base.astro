---
import '../styles/global.css';
import KnowledgeMapNav from '../components/KnowledgeMapNav.astro';

interface Props {
  title: string;
  crumb?: string;
  /** Si hay riel derecho, la rejilla pasa a tres columnas. */
  rail?: boolean;
}
const { title, crumb, rail = false } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · CS3014</title>
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.theme = saved;
    </script>
  </head>

  <body class="min-h-dvh">
    <header
      class="sticky top-0 z-30 border-b border-[var(--rule)] bg-[var(--paper)]/85 backdrop-blur-md"
    >
      <div class="mx-auto flex h-14 max-w-[1680px] items-center gap-5 px-5 lg:px-8">
        <a href="/" class="flex items-baseline gap-1.5 no-underline">
          <span class="font-mono text-sm font-semibold tracking-tight">CS3014</span>
          <span class="tag">EDA</span>
        </a>
        {
          crumb && (
            <>
              <span class="text-[var(--rule)]">/</span>
              <span class="tag truncate">{crumb}</span>
            </>
          )
        }
        <button
          id="theme"
          aria-label="Cambiar tema"
          class="tag ml-auto shrink-0 rounded border border-[var(--rule)] px-2.5 py-1 transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          tema
        </button>
      </div>
    </header>

    <div
      class:list={[
        'mx-auto grid max-w-[1680px] gap-x-10 gap-y-12 px-5 pt-10 pb-24 lg:px-8',
        rail
          ? 'lg:grid-cols-[13rem_minmax(0,1fr)] xl:grid-cols-[13rem_minmax(0,1fr)_15rem]'
          : 'lg:grid-cols-[13rem_minmax(0,1fr)]',
      ]}
    >
      <KnowledgeMapNav />
      <main class="min-w-0"><slot /></main>
      {rail && <aside class="hidden min-w-0 xl:block"><slot name="rail" /></aside>}
    </div>

    <footer class="border-t border-[var(--rule)]">
      <div class="mx-auto max-w-[1680px] px-5 py-8 lg:px-8">
        <p class="tag">
          Estructuras de Datos Avanzadas · el contenido sale del material del curso, nada se inventa
        </p>
      </div>
    </footer>

    <script>
      document.getElementById('theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'light' : 'dark';
        localStorage.setItem('theme', root.dataset.theme);
      });
    </script>
  </body>
</html>
